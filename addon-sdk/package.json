{
  "name": "@apet97/clockify-addon-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for building Clockify add-on servers: manifest builders, request router, runtime adapters, and RS256 webhook-signature verification.",
  "keywords": [
    "clockify",
    "addon",
    "add-on",
    "sdk",
    "typescript",
    "manifest",
    "webhook"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "apet97 <petkovic.aleksandar037@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apet97/addon-ts-sdk.git",
    "directory": "addon-sdk"
  },
  "homepage": "https://github.com/apet97/addon-ts-sdk#readme",
  "bugs": "https://github.com/apet97/addon-ts-sdk/issues",
  "files": ["dist", "LICENSE", "README.md"],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./clockify": {
      "import": "./dist/esm/clockify/index.js",
      "require": "./dist/cjs/clockify/index.js",
      "types": "./dist/esm/clockify/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/esm/adapters/index.js",
      "require": "./dist/cjs/adapters/index.js",
      "types": "./dist/esm/adapters/index.d.ts"
    },
    "./testing": {
      "import": "./dist/esm/testing/index.js",
      "require": "./dist/cjs/testing/index.js",
      "types": "./dist/esm/testing/index.d.ts"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate-clockify-manifest.ts",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "verify:generated": "node scripts/snapshot-generated.cjs && npm run generate && node scripts/diff-generated.cjs",
    "build": "npm run generate && tsc -p tsconfig.esm.json && node scripts/fix-esm-extensions.cjs && tsc -p tsconfig.cjs.json && node scripts/finalize-cjs.js",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test": "vitest run",
    "lint": "echo \"No linter configured (lightweight build)\"",
    "format:check": "echo \"No formatter configured (lightweight build)\"",
    "prepack": "npm run type-check && npm run verify:generated && npm run test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "peerDependencies": {
    "express": "^4.17.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
